#!/usr/bin/env bash
# kitctl: the only way DeepSeek Harness (or anything else that isn't you or Claude) touches a pipeline.
# It runs a short allow-list of kit commands and logs every call to kitctl.log next to it.
#
#   kitctl repos                              the repos in repos.txt and whether each has the kit
#   kitctl overview                           every repo at a glance (goals, task counts, today's usage)
#
#   Read, any time:
#   kitctl <repo> status [--json]             task table
#   kitctl <repo> show T-012                  one task's digest (brief, log, verdicts, last failure)
#   kitctl <repo> goals | events              goal progress | decisions waiting for Claude
#   kitctl <repo> today                       today's model calls and how close the caps are
#   kitctl <repo> stats [days]                per-model results (default 7 days)
#   kitctl <repo> log runner|orchestrator|fallbacks|cron [lines]
#   kitctl <repo> note                        the daily status note (.agents/STATUS.md)
#   kitctl <repo> dirty                       uncommitted changes in the main checkout
#
#   Change, only when the owner says so:
#   kitctl <repo> goal "brief text" [default|risky|fast]
#   kitctl <repo> goal --file briefs/x.md [default|risky|fast]   (files under this folder's briefs/ only)
#   kitctl <repo> requeue T-012 ["hint"]     only for tasks in needs-you
#   kitctl <repo> park T-012 ["why"]         only for tasks in needs-you
#
# Not available, on purpose: approve, reject, escalate, drop, wake, planned, done, task, run, git, and
# anything that edits task files or code. Sign-off belongs to Claude or the owner; see AGENTS.md.
set -uo pipefail
OPS=$(cd "$(dirname "$0")" && pwd)
REPOS="$OPS/repos.txt"; LOG="$OPS/kitctl.log"; BRIEFS="$OPS/briefs"
repo=""; cmd="${1:-}"; rc=0

usage() { sed -n '2,25p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-1}"; }
die() { echo "kitctl: $*" >&2; rc=2; logcall; exit 2; }
logcall() { # time, repo, command, args (one line, truncated), exit code
  local a; a=$(printf '%s ' "${ARGS[@]:-}" | tr '\n\t' '  ' | cut -c1-200)
  printf '%s\t%s\t%s\t%s\t%s\n' "$(date '+%F %T')" "${repo:--}" "${cmd:--}" "$a" "$rc" >>"$LOG"
}

# repos.txt: "<name> <path>" per line; # comments; ~ allowed in paths; paths may contain spaces.
repo_list() { [ -f "$REPOS" ] || die "no repos.txt next to kitctl (copy repos.txt.example)"
  awk '!/^[[:space:]]*(#|$)/ { n=$1; sub(/^[[:space:]]*[^[:space:]]+[[:space:]]+/, ""); print n "\t" $0 }' "$REPOS"; }
repo_path() { local p; p=$(repo_list | awk -F'\t' -v n="$1" '$1==n {print $2; exit}')
  [ -n "$p" ] || die "unknown repo '$1' (see: kitctl repos)"
  p="${p/#\~/$HOME}"; [ -x "$p/.agents/runner.sh" ] || die "$1: no kit at $p"; echo "$p"; }
task_status() { awk '/^---$/{n++; next} n==1 && /^status:/ {print $2; exit}' "$1"; }
is_id() { [[ "$1" =~ ^T-[0-9]+$ ]] || die "not a task id: $1"; }
is_profile() { case "$1" in default|risky|fast) ;; *) die "profile must be default, risky or fast" ;; esac; }
in_repo() { ( cd "$P" && "$@" ); }
mtime() { stat -f %m "$1" 2>/dev/null || stat -c %Y "$1" 2>/dev/null || echo 0; }

repo_today() { # one block per repo: calls by model, GOAT and Claude use against the caps
  ( cd "$P" && source .agents/lib.sh >/dev/null 2>&1 &&
    printf 'Calls today: %s. GOAT %s/%s. Orchestrator wakes %s/%s. Opus retries %s/%s.\n' \
      "$(grep "^$(today)," "$LOGS/runs.csv" 2>/dev/null | grep -cvE ',(gate-|b2)[a-z]*,')" \
      "$(goat_today)" "$GOAT_DAILY_RUN_CAP" \
      "$(grep "^$(today)," "$LOGS/runs.csv" 2>/dev/null | grep -c ',orchestrator,')" "$CLAUDE_ORCH_DAILY_CAP" \
      "$(count_today "$CLAUDE_ESC")" "$CLAUDE_DAILY_CAP"
    grep "^$(today)," "$LOGS/runs.csv" 2>/dev/null | grep -vE ',(gate-|b2)[a-z]*,' | cut -d, -f5 | sort | uniq -c | sort -rn |
      sed 's/^/  /'; true )
}

repo_overview() {
  local f s age
  echo "== $1 ($P)"
  in_repo .agents/orchestrate.sh goals | awk 'NR==1 || $2!="done"'
  s=$(in_repo .agents/runner.sh status --json 2>/dev/null | jq -r '.status' 2>/dev/null | sort | uniq -c | awk '{printf "%s %s, ", $1, $2}')
  echo "Tasks: ${s%, }"
  for f in "$P"/.agents/tasks/T-*.md; do [ -f "$f" ] && [ "$(task_status "$f")" = needs-you ] && echo "  needs you: $(basename "$f" .md)"; done
  repo_today | head -1
  age=$(( ( $(date +%s) - $(mtime "$P/.agents/logs/cron.log") ) / 60 ))
  [ -f "$P/.agents/logs/cron.log" ] && echo "Loop last active ${age} min ago$([ $age -gt 15 ] && echo ' (loop may be stopped)')"
  grep -h "pausing" "$P/.agents/logs/fallbacks.log" 2>/dev/null | tail -1 | sed 's/^/Last pool pause: /'
  [ -n "$(git -C "$P" status --porcelain 2>/dev/null)" ] && echo "Main checkout has uncommitted changes (kitctl $1 dirty)"
  true
}

ARGS=("$@")
case "$cmd" in
  ""|-h|--help|help) usage 0 ;;
  repos) repo_list | while IFS=$'\t' read -r n p; do p="${p/#\~/$HOME}"
           printf '%-16s %s  %s\n' "$n" "$p" "$([ -x "$p/.agents/runner.sh" ] && echo "kit $(cut -d' ' -f1 "$p/.agents/KIT_VERSION" 2>/dev/null)" || echo 'NO KIT')"; done
         logcall; exit 0 ;;
  overview) while IFS=$'\t' read -r n _; do P=$(repo_path "$n") && repo_overview "$n"; echo; done < <(repo_list)
            logcall; exit 0 ;;
esac

repo=$1; cmd=${2:-}; P=$(repo_path "$repo") || exit 2; shift 2 2>/dev/null || shift $#
case "$cmd" in
  status)  [ "${1:-}" = --json ] || [ -z "${1:-}" ] || die "status takes only --json"; in_repo .agents/runner.sh status ${1:+--json}; rc=$? ;;
  show)    is_id "${1:-}"; in_repo .agents/runner.sh show "$1"; rc=$? ;;
  goals)   in_repo .agents/orchestrate.sh goals; rc=$? ;;
  events)  in_repo .agents/orchestrate.sh events; rc=$? ;;
  today)   repo_today; rc=$? ;;
  stats)   n=${1:-7}; [[ "$n" =~ ^[0-9]{1,3}$ ]] || die "stats takes a number of days"; in_repo .agents/stats.sh "$n"; rc=$? ;;
  log)     case "${1:-}" in
             runner) lf=cron.log ;; cron) lf=cron.log ;; orchestrator) lf=orchestrator.log ;; fallbacks) lf=fallbacks.log ;;
             *) die "log takes runner, orchestrator, fallbacks or cron" ;;
           esac
           n=${2:-60}; [[ "$n" =~ ^[0-9]{1,4}$ ]] || die "lines must be a number"
           tail -n "$n" "$P/.agents/logs/$lf" 2>/dev/null || echo "(no $lf yet)" ;;
  note)    cat "$P/.agents/STATUS.md" 2>/dev/null || echo "(no STATUS.md yet; the loop writes one each morning)" ;;
  dirty)   git -C "$P" status --short; rc=$? ;;

  goal)    if [ "${1:-}" = --file ]; then
             bf="${2:-}"; [ -n "$bf" ] || die "goal --file needs a path"
             case "$bf" in /*) ;; *) bf="$OPS/$bf" ;; esac
             real=$(cd "$(dirname "$bf")" 2>/dev/null && pwd -P)/$(basename "$bf")
             case "$real" in "$(cd "$BRIEFS" 2>/dev/null && pwd -P)"/*) ;; *) die "briefs must live under $BRIEFS" ;; esac
             [ -s "$real" ] || die "empty or missing brief: $bf"
             text=$(cat "$real"); prof=${3:-}
           else text=${1:-}; prof=${2:-}; fi
           [ -n "$text" ] || die 'usage: kitctl <repo> goal "brief" [profile]'
           [ -z "$prof" ] || is_profile "$prof"
           in_repo .agents/orchestrate.sh goal "$text" $prof; rc=$? ;;
  requeue|park)
           is_id "${1:-}"; tf="$P/.agents/tasks/$1.md"; [ -f "$tf" ] || die "no task $1 in $repo"
           st=$(task_status "$tf"); [ "$st" = needs-you ] || die "$1 is '$st'; kitctl only acts on tasks in needs-you"
           in_repo .agents/runner.sh "$cmd" "$1" "${2:+(owner via kitctl) $2}"; rc=$? ;;
  approve|reject|escalate|drop|wake|planned|done|task|run|batch|tick)
           die "'$cmd' isn't allowed through kitctl. It belongs to Claude or the owner (see AGENTS.md)." ;;
  *)       die "unknown command '$cmd' (kitctl --help)" ;;
esac
logcall; exit "$rc"
