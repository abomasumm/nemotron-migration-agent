// Rename to ui.spec.ts. Screenshots every page in PAGES and fails on serious axe violations.
import { test, expect } from '@playwright/test';
import AxeBuilder from '@axe-core/playwright';

const PAGES = ['/'];                       // add the routes your UI tasks touch
const VIEWPORTS = [{ w: 1440, h: 900, n: 'desktop' }, { w: 390, h: 844, n: 'mobile' }];

for (const path of PAGES) for (const v of VIEWPORTS) {
  test(`${path} ${v.n}`, async ({ page }) => {
    await page.setViewportSize({ width: v.w, height: v.h });
    await page.goto(process.env.BASE_URL + path);
    const name = (path === '/' ? 'home' : path.replace(/\W+/g, '_')) + `-${v.n}.png`;
    await page.screenshot({ path: `${process.env.SHOTS}/${name}`, fullPage: true });
    const r = await new AxeBuilder({ page }).analyze();
    expect(r.violations.filter(x => ['serious', 'critical'].includes(x.impact ?? ''))).toEqual([]);
  });
}
